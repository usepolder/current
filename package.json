{
  "name": "current-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @usepolder/current-core && npm run build -w @usepolder/current",
    "build:action": "npm run build -w @usepolder/current-core && npm run build -w @usepolder/current-action",
    "typecheck": "npm run build && tsc --noEmit -p packages/current-action",
    "current": "npm run -s build && node packages/current-cli/lib/bin.js"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
